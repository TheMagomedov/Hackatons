# Copy to .env for a real Telegram bot. Do not commit .env.
APP_MODE=live
DATA_DIR=var/live
# Your numeric Telegram user ID, not a username or bot ID.
OWNER_TELEGRAM_ID=
APP_TIMEZONE=Europe/Moscow
TELEGRAM_BOT_TOKEN=
AI_PROVIDER_FACTORY=app.ai.provider:build_provider
IMAGE_PROVIDER_FACTORY=app.media.runtime:build_provider
REPORT_PROVIDER_FACTORY=app.reports.provider:build_provider
BOT_FACTORY=app.bot.adapter:build_bot

# Optional Telegram Mini App. The public URL must end in /mini/.
MINI_APP_URL=
MINI_APP_HOST=127.0.0.1
MINI_APP_PORT=8766
# Optional Windows host mode: a persistent HTTPS proxy forwarding to MINI_APP_PORT.
# Direct HTTPS: https://<public-IP-or-domain>/mini/; see docs/DIRECT_HTTPS.md.
# A separately configured Funnel on isolated 8443 also remains supported.
# Empty keeps the temporary SSH tunnel. Never expose a port serving private ComfyUI.
WINDOWS_PUBLIC_URL=
# Opt in to starting an installed Caddy with a reviewed, private Caddyfile.
# The last three values are only needed by deploy/Caddyfile.windows placeholders.
CADDY_EXE_PATH=
CADDY_CONFIG_PATH=
CADDY_PUBLIC_HOST=
CADDY_BIND_ADDRESS=
CADDY_STORAGE_PATH=
# Only for compose.https.yaml; DNS must point to your server.
MINI_APP_DOMAIN=

# Explicit external text provider (docs/AGENTROUTER.md); no automatic fallback.
TEXT_API_KEY=
TEXT_API_BASE=https://agentrouter.org/v1
TEXT_MODEL=gpt-6.1-sol
TEXT_WIRE_API=responses
TEXT_REASONING_EFFORT=low
TEXT_TIMEOUT_SECONDS=120
TEXT_MAX_RETRIES=1
# Exact-input company-scoped inference cache; 0 disables it.
AI_CACHE_TTL_SECONDS=900
# For an explicitly chosen local alternative, see docs/LOCAL_TEXT.md.
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=your_image_model
# Set to 1 only for model flux1-dev at http://127.0.0.1:<port>/v1.
# Match MODERATION_API_BASE to the same local gateway; see docs/DIRECT_HTTPS.md.
IMAGE_LOCAL_FLUX=0

# Required in live mode: authenticated moderation gateway, e.g. private FLUX API /v1.
# Texts and final images fail closed if the gateway is unavailable or unconfigured.
MODERATION_API_BASE=
MODERATION_API_KEY=
# To use an existing ChatGPT login on the host (see docs/CHATGPT_CONNECTION.md):
# AI_PROVIDER_FACTORY=app.ai.chatgpt:build_provider
# PROVIDER_TIMEOUT_SECONDS=300

# Logical provider operations per owner per UTC day; not a monetary budget.
MAX_AI_OPERATIONS_PER_DAY=100
MAX_CONCURRENT_AI_OPERATIONS=2
MAX_GENERATION_JOBS_PER_DAY=10
MAX_PENDING_JOBS=5
MAX_POSTS_PER_JOB=3
MAX_SOURCES_PER_BUSINESS=10
MAX_SOURCE_BYTES_TOTAL=20000000
MAX_UPLOAD_BYTES=10000000
PROVIDER_TIMEOUT_SECONDS=300
MAX_PUBLISH_LATENESS_SECONDS=900
