# Copy to .env for a real Telegram bot. Do not commit .env.
APP_MODE=live
DATA_DIR=var/live
# Your numeric Telegram user ID, not a username or bot ID.
OWNER_TELEGRAM_ID=
APP_TIMEZONE=Europe/Moscow
TELEGRAM_BOT_TOKEN=
AI_PROVIDER_FACTORY=app.ai.provider:build_provider
IMAGE_PROVIDER_FACTORY=app.media.runtime:build_provider
REPORT_PROVIDER_FACTORY=app.reports.provider:build_provider
BOT_FACTORY=app.bot.adapter:build_bot

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_MAX_RETRIES=1
AI_TIMEOUT_SECONDS=35
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# Logical provider operations per owner per UTC day; not a monetary budget.
MAX_AI_OPERATIONS_PER_DAY=100
MAX_CONCURRENT_AI_OPERATIONS=2
MAX_GENERATION_JOBS_PER_DAY=10
MAX_PENDING_JOBS=5
MAX_POSTS_PER_JOB=3
MAX_SOURCES_PER_BUSINESS=10
MAX_SOURCE_BYTES_TOTAL=20000000
MAX_UPLOAD_BYTES=10000000
PROVIDER_TIMEOUT_SECONDS=120
MAX_PUBLISH_LATENESS_SECONDS=900
