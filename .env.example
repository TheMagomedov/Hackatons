# demo never contacts Telegram or an AI provider; live fails closed without adapters.
APP_MODE=demo
# Choose separate directories before first init: var/demo for demo, var/live for live.
# DATA_DIR is permanently bound to mode + owner; changing APP_MODE cannot convert it.
DATA_DIR=var/demo
OWNER_TELEGRAM_ID=1
APP_TIMEZONE=Europe/Moscow

# For live operation, explicitly set DATA_DIR=var/live, the actual owner ID and private token.
# For an old unbound database: stop, back up the whole directory, inspect with status,
# then adopt-data --data-dir var/live --mode live --owner-id <actual_id>. See README.
# status/adopt-data do not read this file or call providers; never erase a binding to bypass it.
TELEGRAM_BOT_TOKEN=

# Python import targets: each build_provider(settings) returns a protocol implementation.
# Recommended live text provider: installed local Ollama; demo ignores provider factories.
# No API key or cloud fallback. See docs/LOCAL_TEXT.md.
AI_PROVIDER_FACTORY=app.ai.local:build_provider
# Role 4 runtime factory: app.media.runtime:build_provider
IMAGE_PROVIDER_FACTORY=
# Optional role 4 formatter: app.reports.provider:build_provider
REPORT_PROVIDER_FACTORY=
# Role 3 factory returns an adapter with async run(stop_event) and send(notification).
# build_bot(service, settings), example app.bot.adapter:build_bot
BOT_FACTORY=

# Optional Telegram Mini App. Expose /mini/ over HTTPS via a reverse proxy.
MINI_APP_URL=
MINI_APP_PORT=8766
MINI_APP_HOST=127.0.0.1

# Optional direct HTTPS on a Windows PC with a public address; see docs/DIRECT_HTTPS.md.
# Leave CADDY_* empty unless Caddy is installed and router/firewall setup is verified.
WINDOWS_PUBLIC_URL=
CADDY_EXE_PATH=
CADDY_CONFIG_PATH=
CADDY_PUBLIC_HOST=
CADDY_BIND_ADDRESS=
CADDY_STORAGE_PATH=

PROVIDER_TIMEOUT_SECONDS=300
MAX_UPLOAD_BYTES=10000000
MAX_POSTS_PER_JOB=3
MAX_PENDING_JOBS=5
MAX_GENERATION_JOBS_PER_DAY=10
MAX_PUBLISH_LATENESS_SECONDS=900
MAX_AI_OPERATIONS_PER_DAY=100
MAX_CONCURRENT_AI_OPERATIONS=2
MAX_SOURCES_PER_BUSINESS=10
MAX_SOURCE_BYTES_TOTAL=20000000

# Local text generation. Install Ollama and the model separately before live startup.
LOCAL_TEXT_MODEL=qwen3:4b-instruct
LOCAL_TEXT_API_BASE=http://127.0.0.1:11434
LOCAL_TEXT_TIMEOUT_SECONDS=300
LOCAL_TEXT_MAX_RETRIES=1
LOCAL_TEXT_NUM_CTX=8192
LOCAL_TEXT_NUM_THREADS=0
# Windows bootstrap paths to existing files/directories; never commit model weights.
OLLAMA_EXE_PATH=C:/tools/Ollama/ollama.exe
OLLAMA_MODELS_PATH=C:/models/Ollama

# Legacy cloud text configuration is opt-in via app.ai.provider:build_provider.
# It is not read by app.ai.local. No switch to cloud occurs on local failures.
# Use one complete AI_* or TEXT_* family only when explicitly choosing a cloud provider.
# For complete live image/moderation/Telegram configuration use .env.live.example.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_MAX_RETRIES=1
AI_TIMEOUT_SECONDS=35
IMAGE_API_KEY=
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
# Set to 1 only for model flux1-dev at http://127.0.0.1:<port>/v1 (docs/DIRECT_HTTPS.md).
IMAGE_LOCAL_FLUX=0

# Live only; absent configuration blocks material generation/editing/publication.
MODERATION_API_BASE=
MODERATION_API_KEY=
