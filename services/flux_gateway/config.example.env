# Example process-environment configuration. No component automatically reads this file.
# Replace <private-host> with your own private Tailscale hostname.
# Set secrets locally; empty values deliberately fail closed in live mode.
# Optional separate instance: do not stop the existing gateway on 8193.
FLUX_GATEWAY_PORT=8194
FLUX_GATEWAY_HOSTNAME=<private-host>.ts.net
FLUX_GATEWAY_PREFIX=/flux-demo-api
# Set to an existing local secret file. Empty uses image_api/api_key.txt.
FLUX_GATEWAY_KEY_FILE=
# The following variables belong to the Mini App backend, not the gateway.
IMAGE_PROVIDER_FACTORY=app.media.runtime:build_provider
IMAGE_API_BASE=https://<private-host>.ts.net/flux-demo-api/v1
IMAGE_API_KEY=
IMAGE_MODEL=flux1-dev
MODERATION_API_BASE=https://<private-host>.ts.net/flux-demo-api/v1
MODERATION_API_KEY=
PROVIDER_TIMEOUT_SECONDS=300
