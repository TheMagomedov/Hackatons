# Opt-in image for official Codex CLI + ChatGPT sign-in. Images still use API.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DATA_DIR=/data
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm ca-certificates ffmpeg \
    && npm install -g @openai/codex@0.160.0 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt \
    && useradd --uid 10001 --create-home marketer \
    && mkdir -p /data /backups /app/var /home/marketer/.codex \
    && chown -R marketer:marketer /data /backups /app/var /home/marketer/.codex
COPY app ./app
USER marketer
ENTRYPOINT ["python", "-m", "app"]
CMD ["run"]
